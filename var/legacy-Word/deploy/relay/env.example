# 复制为 .env 后填写（勿提交 .env）
RELAY_PORT=3000
RELAY_TOKEN=change-me-ops-token

# S1 控制面
CONTROL_ENABLED=1
CONTROL_REQUIRE_USER=0
# 建议与 RELAY_TOKEN 分开；不填则回落 RELAY_TOKEN
CONTROL_SECRET=change-me-hmac-secret
# CONTROL_DB=/home/ubuntu/gongwen-relay/data/control.sqlite
# CONTROL_MAINTENANCE=系统维护中，请稍后再试
# 注册：open | invite | closed（默认 open；切试用漏斗改 invite）
CONTROL_REGISTER_MODE=open

AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
